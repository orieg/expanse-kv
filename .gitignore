# Build output
/target
/tests/fuzz/target

# Fuzzing corpora and crash artifacts: regenerated by the fuzzer. A crash worth
# keeping becomes a named regression test, not a committed blob.
/tests/fuzz/corpus/
/tests/fuzz/artifacts/

# Upstream compatibility suites are fetched at a pinned commit, never vendored
# (AGENTS.md §3).
/tests/compat_tcl/upstream/

# Quick and smoke benchmark runs (AGENTS.md §8.5). Committed results live
# under results/<suite>/.
/results/quick/

# Agent and editor scratch
/scratch/
.DS_Store
__pycache__/
*.pyc
